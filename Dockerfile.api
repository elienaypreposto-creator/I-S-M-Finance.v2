FROM node:22-alpine

WORKDIR /app

# Instalar pnpm
RUN npm install -g pnpm@9

# Copiar arquivos de configuração do workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./

# Copiar os pacotes necessários para o backend
COPY lib/ ./lib/

COPY artifacts/api-server/ ./artifacts/api-server/

# api-server + db (tsx é dependência de produção: db:migrate no deploy)
RUN pnpm install --filter "@workspace/api-server..." --filter "@workspace/db"

# Fazer o build do backend
RUN cd artifacts/api-server && pnpm run build

# Migrations são um step de deploy (db:migrate), não mais drizzle-kit push no boot.
CMD ["node", "artifacts/api-server/dist/index.cjs"]
