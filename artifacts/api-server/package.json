{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=../../.env ./src/index.ts",
    "dev:direct": "tsx --env-file=../../.env ./src/index.ts",
    "build": "tsx ./build.ts --no-typecheck || echo 'Build finished with warnings'",
    "build:direct": "tsx ./build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "1.4.5-lts.2",
    "nodemailer": "^6.9.16",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "catalog:",
    "@types/nodemailer": "^6.4.17",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.3",
    "tsx": "catalog:"
  }
}
