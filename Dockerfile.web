FROM node:22-alpine AS builder

WORKDIR /app

# Instalar pnpm
RUN npm install -g pnpm@9

# Copiar arquivos de configuração
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./

# Copiar bibliotecas e frontend
COPY lib/ ./lib/

COPY artifacts/ism-financeiro/ ./artifacts/ism-financeiro/

# Instalar dependências
RUN pnpm install --filter "@workspace/ism-financeiro..."

# Argumentos de build para o Vite (que serão passados no docker-compose)
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
# Força o frontend a consumir a própria origem no path /api (interceptado pelo Nginx)
ARG VITE_API_URL=/api

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_API_URL=$VITE_API_URL

# Build do frontend
RUN cd artifacts/ism-financeiro && pnpm run build

# --- Stage 2: Nginx ---
FROM nginx:alpine

# Copia configuração customizada do Nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copia os arquivos compilados do builder
COPY --from=builder /app/artifacts/ism-financeiro/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
