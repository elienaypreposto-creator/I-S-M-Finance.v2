# ISM Finance — variáveis de ambiente de PRODUÇÃO (modelo)
#
# Este arquivo é só o modelo: NÃO coloque valores reais aqui nem no repositório.
# Copie para producao.env FORA do repositório, preencha e crie o secret do Kubernetes:
#   kubectl -n ism-finance create secret generic ism-finance-env --from-env-file=producao.env
# Depois apague o producao.env da máquina (ou guarde no cofre de senhas da equipe).
#
# Formato (--from-env-file): uma variável por linha, sem aspas, sem espaços em volta do "=",
# e SEM comentário na mesma linha do valor (o kubectl incluiria o comentário no valor).
#
# O manifesto deploy/k8s/deploy-ism-finance.yaml já define NODE_ENV, RUN_LOCAL, PORT,
# DATABASE_URL, DATABASE_ADMIN_URL, DATABASE_OWNER_URL, DATABASE_MIGRATE_URL e REDIS_URL.
#
# Segredos: gere cada um separadamente; nunca reaproveite entre variáveis nem do TST/HML.
#   openssl rand -hex 32                       (senhas que entram em URL: só letras e números)
#   openssl rand -base64 48 | tr -d '\n'       (segredos JWT e do backup)
#
# Legenda: [obrigatória] a API não sobe ou não funciona sem ela
#          [recomendada] tem padrão, mas em produção vale definir
#          [opcional]    só se precisar mudar o comportamento padrão

# ===================== Endereços
# [obrigatória] endereço público do sistema: links de e-mail (definir senha, esqueci a senha) e CORS
FRONTEND_URL=https://<dominio-de-producao>
# [recomendada] nº de proxies na frente da API. Ingress -> nginx do web -> API = 2 (padrão).
# Errado = rate limit e auditoria com o IP do proxy em vez do usuário.
TRUST_PROXY_HOPS=2
# [opcional] outras origens permitidas, separadas por vírgula
# CORS_ORIGINS=

# ===================== Banco (Postgres)
# [obrigatória] superusuário do Postgres; usado só pelas migrations e pelo backup (letras e números)
DB_PASSWORD=<gerar com openssl rand -hex 32>
# [obrigatória] senhas dos 3 usuários da API (RLS); as migrations criam os usuários com elas.
# Use senhas diferentes entre si e do DB_PASSWORD (letras e números).
ISM_APP_PASSWORD=<gerar com openssl rand -hex 32>
ISM_ADMIN_PASSWORD=<gerar com openssl rand -hex 32>
ISM_OWNER_PASSWORD=<gerar com openssl rand -hex 32>
# [opcional] conexões por pool (mínimo 5)
# DB_POOL_MAX=12

# ===================== Disco cifrado (LGPD)
# [obrigatória] em produção a API recusa subir sem ISM_DISCO_CIFRADO=1.
# Só é verdade se o volume do Postgres usar uma StorageClass cifrada (ex.: EBS encrypted).
ISM_DISCO_CIFRADO=1

# ===================== Autenticação (JWT)
# [obrigatória] a API recusa subir sem estes dois, ou se forem iguais
JWT_SECRET=<gerar com openssl rand -base64 48>
JWT_ENCRYPT_SECRET=<gerar com openssl rand -base64 48>
# [recomendada] refresh token; sem ela, cai no JWT_SECRET
JWT_REFRESH_SECRET=<gerar com openssl rand -base64 48>

# ===================== Redis (rate limit, bloqueio de conta, acesso anterior)
# [obrigatória] letras e números. Sem Redis a API funciona sem rate limit nem bloqueio de conta.
REDIS_PASSWORD=<gerar com openssl rand -hex 32>

# ===================== E-mail (definir senha, esqueci a senha, convites)
# [obrigatória] sem SMTP ninguém consegue ativar a conta
SMTP_HOST=<servidor-smtp>
SMTP_PORT=587
SMTP_USER=<usuario-smtp>
SMTP_PASS=<senha-smtp>
# [opcional] false = STARTTLS na 587; true = TLS direto na 465
SMTP_SECURE=false
# [recomendada] remetente; precisa ser aceito pelo SMTP (SPF/DKIM do domínio)
SMTP_FROM=ISM Finance <noreply@<dominio>>

# ===================== Administradores do sistema
# [recomendada] recebe as permissões de admin a cada subida da API
ADMIN_EMAIL=<email-do-admin>
# [opcional] mais admins, separados por vírgula
# ADMIN_EMAILS=

# ===================== Backup cifrado
# [obrigatória] senha dos backups pre-deploy-*.sql.enc. Guarde FORA da VM e do cluster:
# sem ela os backups não abrem.
BACKUP_CIPHER_PASS=<gerar com openssl rand -base64 48>

# ===================== NUNCA em produção
# NODE_TLS_REJECT_UNAUTHORIZED=0   (a API recusa subir)
# HIBP_DISABLED=true               (desliga a checagem de senhas vazadas)
# AUTH_LEGACY_REFRESH_BODY=true
# COOKIE_SECURE=false
# ISM_RLS_TEST, ISM_AUTH_TEST, E2E_EMAIL, E2E_SENHA (só testes)
