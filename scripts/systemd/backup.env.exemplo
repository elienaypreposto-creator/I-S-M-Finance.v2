# /etc/ism-backup/<ambiente>.env (ex.: /etc/ism-backup/ism-tst.env). Lido por scripts/backup-db.sh.
# Não vai para o git com valores reais. Dono root, grupo do utilizador do deploy, modo 640.

# Chave PÚBLICA RSA (a privada fica fora da VM). Preferível.
#BACKUP_PUBKEY=/etc/ism-backup/ism-backup-publica.pem

# Sem BACKUP_PUBKEY: segredo próprio do backup (openssl rand -base64 48), fica na VM.
# Não pode ser ISM_OWNER_PASSWORD nem DB_PASSWORD. Sem nenhum dos dois, o backup é recusado.
#BACKUP_CIPHER_PASS=

# Destino fora da VM. Vazio = só local (o script avisa no log).
#   oci://<bucket>/<prefixo>          (oci CLI; BACKUP_OCI_ARGS="--auth instance_principal")
#   rclone:<remote>:<caminho>         (rclone; S3, B2, SFTP...)
#   dir:/caminho/montado              (volume/NFS montado de outra máquina)
#BACKUP_DESTINO=
#BACKUP_OCI_ARGS=--auth instance_principal
#BACKUP_RCLONE_ARGS=

# Alerta (ex.: Healthchecks.io). O script chama /start, a URL no sucesso e /fail na falha.
#BACKUP_PING_URL=https://hc-ping.com/<uuid>

# Retenção local (o destino remoto usa a lifecycle policy do bucket).
#BACKUP_DIARIOS=14
#BACKUP_SEMANAIS=8
#BACKUP_PRE_DEPLOY=10
#BACKUP_DIA_SEMANAL=7
