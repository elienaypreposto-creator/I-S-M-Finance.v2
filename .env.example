# Exemplo de variáveis da API (artifacts/api-server). Copie para .env e ajuste.
# Por enquanto documenta só o login vindo do GovADM; as demais variáveis da API
# (DATABASE_URL, JWT_SECRET, FRONTEND_URL, CORS_ORIGINS, SMTP...) seguem como hoje.

# ─── Login vindo do GovADM (Fase 1) ──────────────────────────────────────────
# GET/POST /api/auth/govadm. Desligado (404) se esta flag não for "true" ou se
# faltar GOVADM_EMISSOR, GOVADM_TOKEN_URL ou FRONTEND_URL (o boot avisa no log).
GOVADM_SSO_HABILITADO=false

# Identifica a instalação do GovADM. Vai em usuario_identidades_externas.emissor:
# trocar este valor desliga os vínculos já cadastrados com o valor antigo.
GOVADM_EMISSOR=govadm-tst

# Base do serviço de token do GovADM (sem /authcontroller). A API chama, servidor a
# servidor, GET {GOVADM_TOKEN_URL}/authcontroller/token/validar/{token}.
# https:// obrigatório; http:// só fora de produção com GOVADM_PERMITIR_HTTP=true.
GOVADM_TOKEN_URL=https://govadm.exemplo.gov.br

# Timeout da chamada de validação, em ms (padrão 4000). Estourou = sso_erro=indisponivel.
GOVADM_INTROSPECCAO_TIMEOUT_MS=4000

# Idade máxima do token do GovADM (claim iat), em segundos (padrão 43200 = 12 h).
GOVADM_TOKEN_MAX_IDADE_S=43200

# Origens (vírgula) aceitas SÓ no POST /api/auth/govadm (form vindo do GovADM).
# Não colocar o GovADM em CORS_ORIGINS.
GOVADM_ORIGENS=https://govadm.exemplo.gov.br

# Só para desenvolvimento/homologação contra GovADM sem TLS. Ignorado com NODE_ENV=production.
GOVADM_PERMITIR_HTTP=false
