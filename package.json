{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -c \"cyan,magenta\" -n \"api,web\" \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "cd artifacts/api-server && pnpm run dev",
    "dev:web": "cd artifacts/ism-financeiro && pnpm run dev",
    "build": "pnpm -r --if-present run build && node scripts/copy-dist.cjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.27.3"
    }
  },
  "private": true,
  "devDependencies": {
    "@esbuild/win32-x64": "0.27.3",
    "concurrently": "^9.2.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
