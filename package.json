{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -c \"cyan,magenta\" -n \"api,web\" \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "cd artifacts/api-server && pnpm run dev",
    "dev:web": "cd artifacts/ism-financeiro && pnpm run dev",
    "build": "pnpm -r --if-present run build && node scripts/copy-dist.cjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test": "jest"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.27.3"
    }
  },
  "private": true,
  "devDependencies": {
    "@esbuild/win32-x64": "0.27.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest": "^30.0.0",
    "@vitejs/plugin-react": "catalog:",
    "concurrently": "^9.2.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "xlsx": "^0.18.5"
  }
}